# Copy to Vercel → Environment Variables (Production). Do not commit real values.
# Netlify frontend import template: ../Sai-Nagendra-Portfolio-React-TypeScript/env.netlify.example
# Phase 1: database + HTTP only. R2 block is phase 2 (see env.example and docs/R2-PHASE-2.md).

NODE_ENV=production
# Do not set PORT on Vercel — the platform injects it for container functions.
# PORT=3001

# Neon — pooled URL for the running API (hostname contains -pooler)
DATABASE_URL='postgresql://neondb_owner:npg_ldznwryiZ02F@ep-gentle-smoke-bdgjtddq-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Neon — direct URL for npm run db:migrate (no -pooler)
DATABASE_DIRECT_URL='postgresql://neondb_owner:npg_ldznwryiZ02F@ep-gentle-smoke-bdgjtddq-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
DATABASE_SSL=true

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=5e997c2c3df15a0c72c3db7dd21ec22fcdb6a89d9f8a3664b1e169c8d188d8bf

# Comma-separated exact origins, HTTPS only in production
ALLOWED_ORIGINS=https://sainagendrayakkaladevara.netlify.app

# Leave empty on Vercel; platform defaults apply when VERCEL=1
TRUST_PROXY=

# --- Phase 2 only: Cloudflare R2 (set all six or leave all unset) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=portfolio-originals
# R2_PUBLIC_BUCKET=portfolio-images
# R2_PUBLIC_URL=https://images.yourdomain.com

# --- Optional: owner admin JWT (all four or none) ---
# AUTH_ISSUER=https://your-idp.example/
# AUTH_AUDIENCE=portfolio-api
# AUTH_JWKS_URL=https://your-idp.example/.well-known/jwks.json
# AUTH_OWNER_SUBJECTS=your-oidc-subject-id