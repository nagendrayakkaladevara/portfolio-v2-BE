{
  "name": "portfolio-v2-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:cleanup": "node --import tsx scripts/cleanup.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "api:generate": "node --import tsx scripts/generate-openapi.ts",
    "db:migrate:production": "node build-tools/scripts/migrate.js",
    "db:cleanup:production": "node build-tools/scripts/cleanup.js",
    "content:import": "node --import tsx scripts/import-posts.ts",
    "content:import:production": "node build-tools/scripts/import-posts.js",
    "config:check": "node --import tsx scripts/check-config.ts",
    "config:check:production": "node build-tools/scripts/check-config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
