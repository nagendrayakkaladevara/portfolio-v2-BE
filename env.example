NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://portfolio:password@localhost:5432/portfolio
# Direct (non-pooler) Neon URL for migration session/advisory locks
DATABASE_DIRECT_URL=postgresql://portfolio:password@localhost:5432/portfolio
DATABASE_SSL=false
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173
# Exact trusted reverse proxy IPs/CIDRs only; empty for direct connections
TRUST_PROXY=
# Configure ALL four to enable owner routes; otherwise fail closed with 503.
# AUTH_ISSUER=https://your-identity-provider.example/
# AUTH_AUDIENCE=portfolio-api
# AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# AUTH_OWNER_SUBJECTS=your-immutable-owner-subject
# Configure ALL R2 values together. Never expose these in VITE_ variables.
# R2_ACCOUNT_ID=your-32-character-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=portfolio-originals
# R2_PUBLIC_BUCKET=portfolio-images
# R2_PUBLIC_URL=https://images.example.com
# AI provider/endpoint deliberately unspecified; generation responds 503.
